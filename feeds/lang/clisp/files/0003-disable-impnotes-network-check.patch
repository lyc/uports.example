From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Max Lee <yowching.lee@gmail.com>
Date: Tue, 9 Jun 2026 05:20:00 +0000
Subject: [PATCH] disable impnotes network check

---
 src/makemake.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/makemake.in b/src/makemake.in
index 333333333..444444444 100644
--- a/src/makemake.in
+++ b/src/makemake.in
@@ -3193,6 +3193,6 @@
-   && { if wget --version >/dev/null 2>/dev/null ; then \
+   && false && { if wget --version >/dev/null 2>/dev/null ; then \
           wget --execute netrc=off --tries=1 --timeout=10 -q ${MYTESTURL}; \
         elif lynx --version >/dev/null 2>/dev/null ; then \
           lynx -connect_timeout=10 -source ${MYTESTURL} > id-href.map; \
         elif curl --version >/dev/null 2>/dev/null ; then \
           curl --max-time 10 --silent ${MYTESTURL} > id-href.map; \
-- 
2.47.1
