#!/usr/bin/env python3
import os
import socket
import sys

expr = None
args = sys.argv[1:]
if args[:1] == ["-e"]:
    if len(args) < 2:
        raise SystemExit("usage: ad-libitum-repl [-e expr] [host [port]]")
    expr = args[1]
    args = args[2:]

host = args[0] if len(args) > 0 else "127.0.0.1"
port = int(args[1]) if len(args) > 1 else 37146


def read_until_prompt(sock):
    data = b""
    while not data.endswith(b"> "):
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    return data


def write_stdout(data):
    if data:
        os.write(sys.stdout.fileno(), data)


def eval_remote(line):
    with socket.create_connection((host, port)) as sock:
        read_until_prompt(sock)
        if isinstance(line, str):
            line = line.encode("utf-8")
        if not line.endswith(b"\n"):
            line += b"\n"
        sock.sendall(line)
        response = read_until_prompt(sock)
        if response.endswith(b"> "):
            response = response[:-2]
        return response


try:
    if expr is not None:
        write_stdout(eval_remote(expr))
        raise SystemExit(0)

    if not sys.stdin.isatty():
        for line in sys.stdin.buffer:
            write_stdout(eval_remote(line))
        raise SystemExit(0)

    with socket.create_connection((host, port)) as sock:
        write_stdout(read_until_prompt(sock))
        while True:
            line = input()
            if not line:
                write_stdout(b"> ")
                continue
            sock.sendall((line + "\n").encode("utf-8"))
            write_stdout(read_until_prompt(sock))
except (KeyboardInterrupt, EOFError):
    pass
