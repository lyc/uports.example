From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: uports <uports@example.invalid>
Date: Sun, 7 Jun 2026 01:05:00 +0800
Subject: [PATCH] fix configure probes for c23

GMP 6.3.0 has old configure compiler probes that define functions with
empty parameter lists and then call them with arguments. C23 treats an
empty parameter list as a no-argument prototype, so modern compilers reject
the probe before GMP can decide the compiler works.

Give the test helpers explicit prototypes that match their calls.
---
 acinclude.m4 | 4 ++--
 configure    | 8 ++++----
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/acinclude.m4 b/acinclude.m4
index 0000000..0000000 100644
--- a/acinclude.m4
+++ b/acinclude.m4
@@ -611,7 +611,7 @@ GMP_PROG_CC_WORKS_PART([$1], [long long reliability test 1],
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
 typedef unsigned long long t1;typedef t1*t2;
-void g(){}
+void g(int a,t2 b,t1 c,t2 d,t2 e,int f){}
 void h(){}
 static __inline__ t1 e(t2 rp,t2 up,int n,t1 v0)
 {t1 c,x,r;int i;if(v0){c=1;for(i=1;i<n;i++){x=up[i];r=x+1;rp[i]=r;}}return c;}
@@ -627,7 +627,7 @@ GMP_PROG_CC_WORKS_PART([$1], [long long reliability test 2],
    1666 to get an ICE with -O1 -mpowerpc64.  */
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
-int g();
+int g(void);
 void f(int u){int i;long long x;x=u?~0:0;if(x)for(i=0;i<9;i++);x&=g();if(x)g();}
 int g(){return 0;}
 #else
diff --git a/configure b/configure
index 0000000..0000000 100755
--- a/configure
+++ b/configure
@@ -6576,7 +6576,7 @@ cat >conftest.c <<EOF
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
 typedef unsigned long long t1;typedef t1*t2;
-void g(){}
+void g(int a,t2 b,t1 c,t2 d,t2 e,int f){}
 void h(){}
 static __inline__ t1 e(t2 rp,t2 up,int n,t1 v0)
 {t1 c,x,r;int i;if(v0){c=1;for(i=1;i<n;i++){x=up[i];r=x+1;rp[i]=r;}}return c;}
@@ -6639,7 +6639,7 @@ cat >conftest.c <<EOF
    1666 to get an ICE with -O1 -mpowerpc64.  */
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
-int g();
+int g(void);
 void f(int u){int i;long long x;x=u?~0:0;if(x)for(i=0;i<9;i++);x&=g();if(x)g();}
 int g(){return 0;}
 #else
@@ -8193,7 +8193,7 @@ cat >conftest.c <<EOF
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
 typedef unsigned long long t1;typedef t1*t2;
-void g(){}
+void g(int a,t2 b,t1 c,t2 d,t2 e,int f){}
 void h(){}
 static __inline__ t1 e(t2 rp,t2 up,int n,t1 v0)
 {t1 c,x,r;int i;if(v0){c=1;for(i=1;i<n;i++){x=up[i];r=x+1;rp[i]=r;}}return c;}
@@ -8256,7 +8256,7 @@ cat >conftest.c <<EOF
    1666 to get an ICE with -O1 -mpowerpc64.  */
 
 #if defined (__GNUC__) && ! defined (__cplusplus)
-int g();
+int g(void);
 void f(int u){int i;long long x;x=u?~0:0;if(x)for(i=0;i<9;i++);x&=g();if(x)g();}
 int g(){return 0;}
 #else
